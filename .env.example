# Supabase (shared between Vercel + local admin)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_ANON_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# WhatsApp mode: web (manage only — sending blocked) | local (admin app sends)
# Vercel (online site): WHATSAPP_MODE=web
# Admin PC (sending): WHATSAPP_MODE=local
WHATSAPP_MODE=web

# Gateway URL:
# - sending from home PC via localhost site: http://localhost:3001
# - sending by pressing the button on the Vercel (online) site:
#   expose the EXE with a tunnel (ngrok/cloudflared) and put its https URL here
#   in Vercel env vars. NOTE: Vercel kills long requests, so big campaigns
#   should be sent from the localhost site on the admin PC.
WHATSAPP_GATEWAY_URL=http://localhost:3001

# Sending pace (messages per minute, default 40)
WHATSAPP_RATE_PER_MINUTE=40

# Local gateway (admin PC only) — must match gateway/server.js GATEWAY_SECRET
WHATSAPP_GATEWAY_URL=http://localhost:3001
WHATSAPP_GATEWAY_SECRET=PASTE_RANDOM_SECRET_HERE

# Auth sessions (phone + password) — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=PASTE_RANDOM_64_HEX_HERE
